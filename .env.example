# --- required ---------------------------------------------------------------
DATABASE_URL=postgres://radar:radar@localhost:5432/radar
# Signs every confirmation, sign-in and unsubscribe link. Changing it logs
# everyone out and voids outstanding links. Generate with: openssl rand -hex 32
SECRET_KEY=
OPENROUTER_API_KEY=

# --- required to actually send email ----------------------------------------
RESEND_API_KEY=
MAIL_FROM=Radar <radar@radar.luizcastro.dev>

# --- optional ---------------------------------------------------------------
APP_URL=http://localhost:3000
PORT=3000
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Ceiling on scoring calls per calendar month; past it, nothing is sent.
MONTHLY_SCORING_CALLS=2000
# Who hears about it when the ceiling is hit.
ALERT_TO=
# 1 writes each edition to out/ instead of sending it. Resend config is then
# not required.
DRY_RUN=1
